Options -Indexes

<FilesMatch "\.(php|php3|php4|php5|phtml|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<FilesMatch "\.(jpg|jpeg|png|webp|avif|pdf)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
