# Copy file ini menjadi .env di root hosting Hostinger.
# Jangan upload file .env asli ke repository publik.

APP_ENV=production

DB_HOST=GANTI_DB_HOST_HOSTINGER
DB_NAME=GANTI_DB_NAME_HOSTINGER
DB_USER=GANTI_DB_USER_HOSTINGER
DB_PASS=GANTI_DB_PASSWORD_HOSTINGER

# Buat string acak minimal 32 karakter.
API_SECRET_KEY=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

# Origin produksi harus persis tanpa path tambahan.
FRONTEND_URL=https://kbbsadunia.com
BACKEND_URL=https://kbbsadunia.com
LOG_LEVEL=INFO
